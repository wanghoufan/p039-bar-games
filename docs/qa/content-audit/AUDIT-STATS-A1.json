      },
      {
        "when": "infoGain∈{低,0} 且 社交能量=低 且 关系推进=低",
        "to": "DELETE_CANDIDATE"
      },
      {
        "when": "infoGain∈{低,0} 且两轴都∈{中,低}（非全低）",
        "to": "REWRITE_CANDIDATE"
      },
      {
        "when": "infoGain=中 但两轴都为低",
        "to": "REWRITE_CANDIDATE"
      }
    ],
